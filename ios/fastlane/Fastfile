default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )
  end

  # Tải provisioning profile App Store có sẵn trên Apple Developer và cài vào máy build.
  lane :fetch_profile do
    get_provisioning_profile(
      api_key: asc_key,
      app_identifier: "com.manabihub.kanjin5",
      readonly: true,
      provisioning_name: ENV["IOS_PROFILE_NAME"].to_s.empty? ? "Kanji N5 AppStore" : ENV["IOS_PROFILE_NAME"],
      ignore_profiles_with_different_name: true,
      skip_certificate_verification: true
    )
  end

  # Chuyển target Runner sang ký thủ công bằng chứng chỉ + profile phân phối.
  lane :prepare_signing do
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"].to_s.empty? ? "SLR7396ZXZ" : ENV["APPLE_TEAM_ID"],
      targets: ["Runner"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["IOS_PROFILE_NAME"],
      bundle_identifier: "com.manabihub.kanjin5"
    )
  end

  # Đưa IPA lên TestFlight.
  lane :beta do
    upload_to_testflight(
      api_key: asc_key,
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true
    )
  end

  # Cập nhật nội dung store + screenshot rồi gửi review (bản build mới nhất của phiên bản).
  lane :release do
    deliver(
      api_key: asc_key,
      app_version: ENV["APP_VERSION"],
      skip_binary_upload: true,
      skip_screenshots: Dir.glob("screenshots/**/*.png").empty?,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
